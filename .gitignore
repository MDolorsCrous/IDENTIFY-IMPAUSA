# dependencias
node_modules/

# secretos — nunca subir
.env
.env.local
*.key

# build
dist/
build/
.netlify/

# sistema
.DS_Store
Thumbs.db

# informes generados con datos reales de personas
salidas/
*.pdf
!docs/**/*.pdf

# el HTML renderizado se regenera con tools/render-informe.mjs
informe-*.html
test-identify.html

# los JSON de datos/ SI se versionan: son el registro de cada test
!datos/*.json

# el encargo se regenera con el informe
datos/*.prompt.md

# el paquete de la skill se regenera con tools/gen-skill.mjs
# (la carpeta skill/ SI se versiona: es texto y sus diffs se leen)
skill/*.skill
