# Identify by Impausa — cabeceras equivalentes a las de netlify.toml, para
# cuando el sitio NO se despliega por Netlify sino que se sube a mano con
# FileZilla a un servidor Apache (mod_headers).
#
# Colocar este fichero en el MISMO directorio del servidor donde se sube
# test-identify.html (o el index.html que lo sustituya): Apache solo aplica
# un .htaccess a su propio directorio y a los de debajo.
#
# Mismo criterio que en netlify.toml: quién puede enmarcar la aplicación en
# un iframe. Antes se podía usar `X-Frame-Options: DENY`, que prohíbe
# cualquier iframe venga de donde venga; ahora hace falta una excepción para
# impausa.com, y X-Frame-Options no sabe hacerlas —su variante ALLOW-FROM no
# la respeta ningún navegador actual—. La forma de decir «solo estos» es
# frame-ancestors, así que se usa solo esta cabecera y no las dos a la vez:
# con las dos, algunos navegadores hacen caso a la más estricta y la
# excepción no serviría de nada.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Content-Security-Policy "frame-ancestors 'self' https://impausa.com https://*.impausa.com"
</IfModule>
